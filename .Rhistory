usethis::use_lifecycle_badge('experimental')
usethis::use_badge('Test Coverage')
usethis::use_badge('Test Coverage', src='#')
usethis::use_badge('Test Coverage', src='#', href='#')
install.packages('badgecreatr')
devtools::install_github("rmhogervorst/badgecreatr")
library(badgecreatr)
badgeplacer(location = ".", status = "active", githubaccount = NULL,
githubrepo = NULL, branch = NULL, name = "README.Rmd")
?badgeplacer
badgeplacer(location = ".", status = "active", githubaccount = "peernisse",
githubrepo = "dphshiny", branch = "dev", name = "README.Rmd")
usethis::use_readme_rmd()
badgeplacer(location = ".", status = "active", githubaccount = "peernisse",
githubrepo = "dphshiny", branch = "dev", name = "README.Rmd")
remove.packages('badgecreatr')
